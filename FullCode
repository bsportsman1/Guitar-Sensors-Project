// Thermistor and Kalman filter
const int NODE_A_PIN = 35;
const float NODE_A_DIVIDER = (100.0 + 47.0) / 47.0;

const int MUX_ADC_PIN = 34;
const float PIN6_DIV = (100.0 + 47.0) / 47.0;

const float THERM_CAL_SLOPE = 0.111f;
const float THERM_CAL_INTERCEPT = -0.59f;

float thermKalmanEstimate = NAN;
float thermKalmanVariance = 1.0;
const float THERM_KALMAN_Q = 0.01;
const float THERM_KALMAN_R = 0.12;

float kalman(float z) {
  if (isnan(thermKalmanEstimate)) {
    thermKalmanEstimate = z;
    return thermKalmanEstimate;
  }

  thermKalmanVariance += THERM_KALMAN_Q;
  float kalmanGain =
    thermKalmanVariance /
    (thermKalmanVariance + THERM_KALMAN_R);

  thermKalmanEstimate +=
    kalmanGain * (z - thermKalmanEstimate);

  thermKalmanVariance *= (1.0f - kalmanGain);

  return thermKalmanEstimate;
}

