// Score upload
void uploadGuitarScoreChannel() {
  if (scoreChannelID == 0 ||
      String(scoreWriteAPIKey) ==
      "PASTE_YOUR_SCORE_WRITE_API_KEY") {
    return;
  }

  if (isnan(guitarScore)) return;

  ThingSpeak.setField(1, guitarScore);
  ThingSpeak.setField(2, humScore);
  ThingSpeak.setField(3, tempScore);
  ThingSpeak.setField(
    4,
    tempDisagree ? 1 : 0
  );

  int response = ThingSpeak.writeFields(
    scoreChannelID,
    scoreWriteAPIKey
  );

  if (response == 200) {
    Serial.printf(
      "# Health Channel OK: Score=%.1f (H=%.0f, T=%.0f, Play=%.0f, Press=%.0f)\n",
      guitarScore,
      humScore,
      tempScore,
      playtimeScore,
      pressureScore
    );
  } else {
    Serial.printf(
      "# Health Channel upload failed. Code: %d\n",
      response
    );
  }
}

// Environmental upload
void doUpload(bool event) {
  float capOut = event
    ? capPF(capLast)
    : capPF(capPeakTd > 0 ? capPeakTd : capLast);

  int touchedOut = event
    ? (capPressed ? 1 : 0)
    : ((capPressed || touchLatch) ? 1 : 0);

  ThingSpeak.setField(
    1,
    bmp.readTemperature()
  );

  ThingSpeak.setField(
    2,
    bmp.readPressure() / 100.0F
  );

  ThingSpeak.setField(
    3,
    sht31.readTemperature()
  );

  float uploadHumidity = sht31.readHumidity() - 17.5f;
  if (uploadHumidity < 0.0f) {
    uploadHumidity = 0.0f;
  }

  ThingSpeak.setField(4, uploadHumidity);
  ThingSpeak.setField(5, thermRaw);
  ThingSpeak.setField(6, thermKF);
  ThingSpeak.setField(7, capOut);
  ThingSpeak.setField(8, touchedOut);

  int response = ThingSpeak.writeFields(
    channelID,
    writeAPIKey
  );

  Serial.printf(
    "# ThingSpeak Primary %s (%s): cap=%.1f pF, touched=%d\n",
    response == 200 ? "OK" : "FAILED",
    event ? "event" : "periodic",
    capOut,
    touchedOut
  );

  uploadGuitarScoreChannel();

  lastUpload = millis();
  pendingUpload = false;
  touchLatch = false;
  capPeakTd = 0;
}

// Setup
void setup() {
  Serial.begin(115200);

  // Restore saved playtime and pressure baseline.
  preferences.begin("guitar", false);
  cumulativePlayingMs = preferences.getULong64("playMs", 0);
  completedSessions = preferences.getULong("sessions", 0);
  pressureBaselineHpa = preferences.getFloat("pBase", NAN);

  delay(1000);

  Wire.begin(21, 22);
  Wire.setClock(100000);

  analogSetAttenuation(ADC_11db);

  pinMode(PIN_DRIVE, OUTPUT);
  pinMode(PIN_SENSE, INPUT);

  attachInterrupt(
    PIN_SENSE,
    onCapEdge,
    RISING
  );

  pinMode(PIN_MUX_SEL, OUTPUT);
  digitalWrite(PIN_MUX_SEL, LOW);

  // SHT31 initialization
  Serial.println("Initializing SHT31...");

  if (!sht31.begin(0x44)) {
    Serial.println("SHT31 NOT FOUND at 0x44!");

    while (1) {
      delay(1000);
      Serial.println("Still waiting for SHT31...");
    }
  }

  float shtTestTemp = sht31.readTemperature();
  float shtTestHumidity = sht31.readHumidity();

  if (isnan(shtTestTemp) ||
      isnan(shtTestHumidity)) {
    Serial.println(
      "SHT31 initialized, but returned invalid readings."
    );

    while (1) {
      delay(1000);
      Serial.println(
        "Waiting for valid SHT31 readings..."
      );
    }
  }

  Serial.printf(
    "SHT31 OK: %.2f C, %.2f %%RH\n",
    shtTestTemp,
    shtTestHumidity
  );

  // BMP280 initialization
  if (!bmp.begin(0x77)) {
    Serial.println("BMP280 NOT FOUND!");

    while (1) {
      delay(1000);
      Serial.println("Still waiting for BMP280...");
    }
  }

  Serial.println("BMP280 OK.");

  // OLED initialization
  u8g2.setBusClock(100000);
  u8g2.begin();

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);

  u8g2.drawStr(
    0,
    12,
    "Guitar case monitor"
  );

  u8g2.drawStr(
    0,
    26,
    "Starting..."
  );

  u8g2.sendBuffer();

  // Wi-Fi
  WiFi.mode(WIFI_STA);

  Serial.println("Connecting to Wi-Fi...");

  WiFi.begin(ssid, password);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED &&
         attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Wi-Fi connected!");

    Serial.print("IP address: ");
    Serial.println(WiFi.localIP());
  }

  ThingSpeak.begin(client);

  u8g2.clearBuffer();

  u8g2.drawStr(
    0,
    12,
    "Hands off the"
  );

  u8g2.drawStr(
    0,
    26,
    "touch sensor..."
  );

  u8g2.sendBuffer();

  delay(3000);

  capBaseline = capMeasure(101);
}

// Main loop
void loop() {
  // Environmental measurements
  float bmpTemperature = bmp.readTemperature();

  // Air pressure in hectopascals (hPa)
  float bmpPressure =
    bmp.readPressure() / 100.0F;

  float shtTemperature =
    sht31.readTemperature();

  float rawHumidity =
    sht31.readHumidity();

  // Apply the SHT31 humidity offset.
  float shtHumidity =
    rawHumidity - 17.5f;

  if (shtHumidity < 0.0f) {
    shtHumidity = 0.0f;
  }

  // Thermistor measurement
  float pin6 = readThermV();

  thermRaw =
    (pin6 - THERM_CAL_INTERCEPT) / THERM_CAL_SLOPE;

  thermKF = kalman(thermRaw);

  // Include cumulative and current-session playtime in the score.
  float activeSessionMs = 0.0f;

  if (sessionHasTap &&
      lastSessionTapMs >= firstSessionTapMs) {
    activeSessionMs =
      lastSessionTapMs - firstSessionTapMs;
  }

  float totalPlaytimeMinutes =
    (cumulativePlayingMs + activeSessionMs) / 60000.0f;

  // Calculate the weighted guitar storage score.
  computeGuitarScore(
    thermKF,
    bmpTemperature,
    shtTemperature,
    shtHumidity,
    bmpPressure,
    totalPlaytimeMinutes
  );

  if (tempDisagree != lastTempDisagree) {
    lastTempDisagree = tempDisagree;

    if (tempDisagree) {
      Serial.printf(
        "# TEMP DISCREPANCY: thermistor=%.2f C, BMP280=%.2f C -> using SHT31 %.2f C\n",
        thermKF,
        bmpTemperature,
        shtTemperature
      );
    } else {
      Serial.println(
        "# Temperature sensors agree again."
      );
    }
  }

  // Piezo measurement
  piezoPeakMv = piezoBurst();

  // Accumulate display averages
  sBmpT += bmpTemperature;
  sShtT += shtTemperature;
  sShtH += shtHumidity;
  sP += bmpPressure;
  sTh += thermKF;

  nAvg++;

  // Serial Monitor output
  if (LABELED) {
    Serial.printf(
      "t=%lu ms | BMP280=%.2f C | Pressure=%.2f hPa | therm raw=%.2f C | therm Kalman=%.2f C | cap=%.1f pF | pressed=%s | mode=%s | piezo=%.0f raw / %.0f KF mV p-p (base %.0f / th %.0f) | taps=%d | session taps=%d | RH=%.1f%% | H=%.0f T=%.0f Ptime=%.0f Press=%.0f score=%.1f%s\n",
      millis(),
      bmpTemperature,
      bmpPressure,
      thermRaw,
      thermKF,
      capPF(capLast),
      capPressed ? "YES" : "no",
      sleepMode ? "SLEEP" : "ACTIVE",
      piezoPeakMv,
      piezoFilteredMv,
      piezoNoiseFloorMv,
      piezoThresholdMv,
      tapCount,
      sessionTapCount,
      shtHumidity,
      humScore,
      tempScore,
      playtimeScore,
      pressureScore,
      guitarScore,
      tempDisagree ? " (temp flag)" : ""
    );
  }

  unsigned long t = millis();

  piezoPeakMv = 0;

  while (millis() - t < 250) {
    updateTouch();

    if (!previousSleepMode && sleepMode) {
      finishPlayingSession();
    }

    previousSleepMode = sleepMode;

    float pp = piezoBurst();

    if (pp > piezoPeakMv) {
      piezoPeakMv = pp;
    }

    if (!isnan(capLast) &&
        capLast > capPeakTd) {
      capPeakTd = capLast;
    }

    if (capPressed) {
      touchLatch = true;
    }

    if (capPressed != lastPressedSeen) {
      lastPressedSeen = capPressed;
      pendingUpload = true;

      if (!capPressed) {
        everTouched = true;
        lastTouchEnd = millis();
      }
    }

    delay(20);
  }

  // OLED refresh
  if (millis() - lastDisp >= DISPLAY_MS ||
      sleepMode != modeShown) {
    updateOLED();
  }

  // ThingSpeak upload scheduling
  if (WiFi.status() == WL_CONNECTED) {
    unsigned long since =
      millis() - lastUpload;

    bool periodicDue =
      since >= (sleepMode ? 120000UL : 20000UL);

    bool eventDue =
      pendingUpload && since >= 15500UL;

    if (periodicDue) {
      doUpload(false);
    } else if (eventDue) {
      doUpload(true);
    }
  }
}
